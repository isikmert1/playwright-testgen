{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "playwright-testgen/healer-input.v1",
  "title": "Healer input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "spec_path",
    "starting_spec_sha256",
    "criteria",
    "source"
  ],
  "properties": {
    "schema_version": { "const": "healer-input.v1" },
    "run_id": { "type": "string", "pattern": "^tg-[a-f0-9]{24}$" },
    "mode": { "enum": ["pipeline", "standalone"] },
    "spec_path": { "type": "string", "minLength": 1, "maxLength": 240 },
    "starting_spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "assertion_locations", "step_title"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
          },
          "outcome": { "type": "string", "minLength": 1, "maxLength": 200 },
          "assertion_locations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 240 }
          },
          "step_title": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "handoff_sha256"],
      "properties": {
        "kind": {
          "enum": ["author-handoff", "human-approved-existing-spec"]
        },
        "handoff_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
