{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "playwright-testgen/healer-trace.v1",
  "title": "Healer trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "spec_path",
    "handoff_read",
    "attempts",
    "repairs",
    "final_classification",
    "disposition",
    "next_owner",
    "escalation",
    "cleanup"
  ],
  "properties": {
    "schema_version": { "const": "healer-trace.v1" },
    "run_id": { "type": "string", "pattern": "^tg-[a-f0-9]{24}$" },
    "spec_path": { "type": "string", "minLength": 1, "maxLength": 240 },
    "handoff_read": { "const": true },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "kind",
          "hypothesis",
          "failure_signature",
          "evidence_summary",
          "classification",
          "action",
          "outcome"
        ],
        "properties": {
          "number": { "type": "integer", "minimum": 1, "maximum": 5 },
          "kind": { "enum": ["debug-run", "confirmation-run"] },
          "hypothesis": { "type": "string", "minLength": 1, "maxLength": 200 },
          "failure_signature": { "type": ["string", "null"], "maxLength": 160 },
          "evidence_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "classification": {
            "enum": [
              null,
              "selector-drift",
              "timing",
              "expectation-drift",
              "intent-wrong",
              "environment-or-auth",
              "product-behavior-wrong",
              "unresolved"
            ]
          },
          "action": {
            "type": ["string", "null"],
            "maxLength": 200
          },
          "outcome": { "enum": ["pass", "fail", "blocked"] },
          "product_behavior_evidence": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": [
              "criterion_id",
              "required_outcome",
              "observed_behavior",
              "contradiction",
              "expectation_drift_rejected"
            ],
            "properties": {
              "criterion_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
              },
              "required_outcome": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "observed_behavior": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "contradiction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "expectation_drift_rejected": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": { "const": "product-behavior-wrong" }
              },
              "required": ["classification"]
            },
            "then": {
              "required": ["product_behavior_evidence"],
              "properties": {
                "product_behavior_evidence": { "type": "object" }
              }
            },
            "else": {
              "properties": {
                "product_behavior_evidence": { "type": "null" }
              }
            }
          }
        ]
      }
    },
    "repairs": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_number", "paths", "reason"],
        "properties": {
          "attempt_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 240 }
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "final_classification": {
      "enum": [
        null,
        "selector-drift",
        "timing",
        "expectation-drift",
        "intent-wrong",
        "environment-or-auth",
        "product-behavior-wrong",
        "unresolved"
      ]
    },
    "disposition": {
      "enum": [
        "fixed",
        "needs-author-revision",
        "needs-user-input",
        "product-behavior-wrong",
        "unresolved-after-healing"
      ]
    },
    "next_owner": { "enum": ["human", "author", "product-owner"] },
    "escalation": { "type": ["string", "null"], "maxLength": 200 },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "browser_session", "scratch"],
      "properties": {
        "runner": { "enum": ["stopped", "not-started", "cleanup-failed"] },
        "browser_session": {
          "enum": ["closed", "detached", "not-opened", "cleanup-failed"]
        },
        "scratch": {
          "enum": ["retained-pending-acceptance", "removed", "cleanup-failed"]
        }
      }
    }
  }
}
