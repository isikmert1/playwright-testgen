{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "playwright-testgen/vacuity-report.v1",
  "title": "Vacuity report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "spec_path",
    "behavior",
    "assertion_sensitivity",
    "disposition"
  ],
  "properties": {
    "schema_version": { "const": "vacuity-report.v1" },
    "run_id": { "type": "string", "pattern": "^tg-[a-f0-9]{24}$" },
    "spec_path": { "$ref": "#/$defs/path" },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mutation",
        "baseline",
        "mutant",
        "reason",
        "error",
        "isolation",
        "cleanup"
      ],
      "properties": {
        "status": {
          "enum": ["killed", "survived", "unavailable", "error"]
        },
        "mutation": {
          "anyOf": [{ "$ref": "#/$defs/mutation" }, { "type": "null" }]
        },
        "baseline": { "$ref": "#/$defs/outcome" },
        "mutant": { "$ref": "#/$defs/outcome" },
        "reason": {
          "enum": [null, "adapter-absent", "criterion-unmapped"]
        },
        "error": { "$ref": "#/$defs/error" },
        "isolation": { "enum": ["disposable-worktree", "not-run"] },
        "cleanup": { "enum": ["removed", "failed", "not-run"] }
      }
    },
    "assertion_sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "baseline",
        "mutant",
        "error",
        "isolation",
        "cleanup"
      ],
      "properties": {
        "status": { "enum": ["killed", "survived", "not-run", "error"] },
        "baseline": { "$ref": "#/$defs/outcome" },
        "mutant": { "$ref": "#/$defs/outcome" },
        "error": { "$ref": "#/$defs/error" },
        "isolation": { "enum": ["disposable-copy", "not-run"] },
        "cleanup": { "enum": ["removed", "failed", "not-run"] }
      }
    },
    "disposition": {
      "enum": [
        "verified-non-vacuous",
        "rejected-vacuous",
        "assertion-sensitive-only",
        "mutation-not-verified",
        "verification-error"
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
    },
    "path": { "type": "string", "minLength": 1, "maxLength": 240 },
    "outcome": { "enum": [null, "pass", "fail", "error"] },
    "error": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "mutation_id",
        "criterion_id",
        "definition_digest",
        "affected_paths"
      ],
      "properties": {
        "adapter_id": { "$ref": "#/$defs/id" },
        "mutation_id": { "$ref": "#/$defs/id" },
        "criterion_id": { "$ref": "#/$defs/id" },
        "definition_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "affected_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    }
  }
}
