{
  "name": "playwright-testgen",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code plugin for grounded Playwright test generation and repair using the official Playwright CLI.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "eval:generation": "node scripts/run-generation-eval.cjs",
    "eval:candidate": "node scripts/run-generation-candidate.cjs",
    "eval:selector-repair": "node scripts/run-selector-repair-eval.cjs",
    "eval:healer-defect-refusal": "node scripts/run-healer-defect-refusal.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "shell-quote": "1.10.0"
  }
}
